{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vela-trip-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "USER_PROFILE", "class_name": "UserProfileDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConversationDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserProfileDO"] }
  ],
  "vars": {
    "HOFJ_BASE_URL": "https://api.hofj.com",
    "HOFJ_BRAND": "terrarossa.com",
    "HOFJ_LOCALE": "it"
  }
}
